{
  "name": "@floating-ui/popper-compat",
  "version": "1.8.0",
  "private": true,
  "description": "Build @floating-ui/dom into a copyable @popperjs/core package.",
  "type": "module",
  "scripts": {
    "build:popper": "../../node_modules/.bin/rollup -c && node ./scripts/write-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "workspace:*"
  }
}
