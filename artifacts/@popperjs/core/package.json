{
  "name": "@ylmc2026/popper-compat",
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "description": "Popper-compatible build of @floating-ui/dom@1.8.0. Use it in place of @popperjs/core to fix Element Plus zoom misalignment.",
  "homepage": "https://github.com/YLMC2017/floating-ui#readme",
  "bugs": {
    "url": "https://github.com/YLMC2017/floating-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YLMC2017/floating-ui.git",
    "directory": "packages/popper-compat"
  },
  "main": "./dist/cjs/popper.cjs",
  "module": "./lib/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/index.js",
      "require": "./dist/cjs/popper.cjs",
      "default": "./dist/cjs/popper.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.d.ts",
    "dist",
    "lib",
    "README.md"
  ],
  "floatingUi": {
    "dom": "1.8.0",
    "core": "1.8.0",
    "utils": "0.2.12"
  }
}
